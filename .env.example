# Independent backend API
PORT=4000
POSTGRES_HOST_PORT=5432
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
DATABASE_URL=postgres://amoria:amoria_password@postgres:5432/amoria
JWT_SECRET=replace-with-long-random-secret-at-least-32-chars
AUTH_SECURITY_HMAC_SECRET=replace-with-a-separate-random-secret-at-least-32-chars
MESSAGE_ABUSE_HMAC_SECRET=replace-with-another-random-secret-at-least-32-chars
MESSAGE_ABUSE_RETENTION_HOURS=48
PUBLIC_API_URL=http://localhost:4000
PUBLIC_MEDIA_URL=http://localhost:4000/media
# Dev/test only. Must stay false in production; production public URLs must be HTTPS
# and must not point to localhost, private IPs, or minio.
ALLOW_LOCAL_PUBLIC_URLS=true
UPLOADS_DIR=./uploads
OBJECT_STORAGE_PROVIDER="s3"
S3_ENDPOINT="http://minio:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="amoria"
S3_PUBLIC_BASE_URL="http://localhost:9000/amoria"
S3_FORCE_PATH_STYLE="1"
OBJECT_STORAGE_DELETE_TIMEOUT_MS=10000
NODE_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Development defaults to not trusting forwarded headers. Production must set
# an exact proxy IP/CIDR list (preferred) or a bounded hop count.
TRUST_PROXY=false
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
RELEASE_SHA=development
APP_VERSION=0.1.0
SUPPORT_EMAIL=support@example.invalid
# Optional only when enhanced Expo Push Service access-token security is enabled.
EXPO_PUSH_ACCESS_TOKEN=
PUSH_REQUEST_TIMEOUT_MS=5000
PUSH_WORKER_INTERVAL_MS=5000
ACCOUNT_DELETION_WORKER_INTERVAL_MS=30000

# Self-hosted public-photo moderation worker. Keep the Python/model runtime outside
# user-media storage. The worker has no public listener and accepts media IDs from DB only.
MODERATION_PYTHON=F:\Dev\Amoria-Models\opennsfw-onnx-0.1.0\Scripts\python.exe
MODERATION_WORKER_CONCURRENCY=1
MODERATION_WORKER_POLL_SECONDS=2
MODERATION_MAX_ATTEMPTS=3
MODERATION_RETRY_BASE_SECONDS=15
MODERATION_MAX_IMAGE_BYTES=10485760
MODERATION_MAX_DIMENSION=4096
MODERATION_INFERENCE_TIMEOUT_SECONDS=30
MODERATION_RUNNING_TIMEOUT_SECONDS=180
MODERATION_APPROVE_MAX_NSFW=0.20
MODERATION_RESTRICT_MIN_NSFW=0.95
PERSON_YOLOX_ONNX_MODEL_PATH=F:\Dev\Amoria-Models\person-presence-v1\yolox_nano.onnx
PERSON_YUNET_ONNX_MODEL_PATH=F:\Dev\Amoria-Models\person-presence-v1\face_detection_yunet_2023mar.onnx
GRAPHIC_SAFETY_ONNX_MODEL_PATH=F:\Dev\Amoria-Models\graphic-safety-v1\image-safety-classifier-s.onnx
MODERATION_GRAPHIC_REVIEW_MIN_NSFL=0.20
MODERATION_GRAPHIC_RESTRICT_MIN_NSFL=0.90

# Self-hosted text moderation. The subprocess uses stdin/stdout only and the pinned
# model directory is outside the repository and user-media storage.
TEXT_MODERATION_ENABLED=true
TEXT_MODERATION_PYTHON=F:\Dev\Amoria-Models\text-moderation-v1\Scripts\python.exe
TEXT_MODERATION_MODEL_DIR=F:\Dev\Amoria-Models\text-moderation-v1\model
TEXT_MODERATION_TIMEOUT_MS=5000

# Standard SMTP. The defaults below target the optional local Mailpit QA profile.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_REQUIRE_TLS=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_FROM=no-reply@amoria.local
MAIL_FROM_NAME=Amoria

# Authentication email and PostgreSQL-backed abuse controls.
EMAIL_CHALLENGE_TTL_SEC=900
EMAIL_CHALLENGE_MAX_ATTEMPTS=5
EMAIL_RESEND_COOLDOWN_SEC=60
EMAIL_DOMAIN_DNS_TIMEOUT_MS=2500
EMAIL_DOMAIN_CACHE_TTL_SEC=21600
DISPOSABLE_EMAIL_DOMAIN_OVERRIDES=
AUTH_RATE_LIMIT_RETENTION_HOURS=168
REGISTER_EMAIL_LIMIT=3
REGISTER_IP_LIMIT=10
REGISTER_DEVICE_LIMIT=5
LOGIN_EMAIL_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_DEVICE_FAILURE_LIMIT=10
RESEND_EMAIL_LIMIT=5
RESEND_IP_LIMIT=20
RESEND_DEVICE_LIMIT=10
RESET_EMAIL_LIMIT=3
RESET_IP_LIMIT=20
RESET_DEVICE_LIMIT=10

# Explicit Admin/Ops bootstrap. These must reference existing real users only.
# Comma-separated values are supported. The bootstrap assigns the owner role.
ADMIN_BOOTSTRAP_AMORIA_IDS=
ADMIN_BOOTSTRAP_USER_IDS=

# Creates or promotes a real owner admin account via npm run admin:create-owner.
# Leave ADMIN_OWNER_PASSWORD empty locally to generate a strong password outside the repo.
ADMIN_OWNER_EMAIL=
ADMIN_OWNER_PASSWORD=
ADMIN_OWNER_DISPLAY_NAME=Amoria Owner
