rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isSupportedImage() {
      return request.resource != null &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function underSize(maxBytes) {
      return request.resource != null &&
        request.resource.size <= maxBytes;
    }

    match /users/{uid}/profile/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) &&
        fileName.matches('avatar\\.(jpg|jpeg|png|webp)') &&
        isSupportedImage() &&
        underSize(5 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }

    match /users/{uid}/photos/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid) &&
        fileName.matches('[A-Za-z0-9_-]+\\.(jpg|jpeg|png|webp)') &&
        isSupportedImage() &&
        underSize(10 * 1024 * 1024);
      allow delete: if isOwner(uid);
    }

    match /announcements/{authorUid}/{announcementId}/{fileName} {
      allow read: if signedIn();
      allow create, update: if isOwner(authorUid) &&
        fileName.matches('cover\\.(jpg|jpeg|png|webp)') &&
        isSupportedImage() &&
        underSize(10 * 1024 * 1024);
      allow delete: if isOwner(authorUid);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
