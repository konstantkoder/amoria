{
  "name": "amoria-ready",
  "version": "1.0.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "sanity:all": "powershell -NoLogo -NonInteractive -ExecutionPolicy Bypass -File scripts/sanity_all.ps1",
    "sanity:swipe": "powershell -NoLogo -NonInteractive -ExecutionPolicy Bypass -File scripts/sanity_swipe.ps1",
    "sanity:onboarding": "powershell -NoLogo -NonInteractive -ExecutionPolicy Bypass -File scripts/sanity_fix_reanimated_onboarding.ps1",
    "sanity:deck": "powershell -NoLogo -NonInteractive -ExecutionPolicy Bypass -File scripts/sanity_deck.ps1",
    "sanity:flirt": "powershell -NoLogo -NonInteractive -ExecutionPolicy Bypass -File scripts/sanity_flirt.ps1",
    "dev:lan": "npx expo start --dev-client -c --port 8092 --lan",
    "dev:tunnel": "npx expo start --dev-client -c --port 8092 --tunnel",
    "dev:localhost": "npx expo start --dev-client -c --port 8092 --localhost",
    "dev:usb": "powershell -NoLogo -NonInteractive -ExecutionPolicy Bypass -File scripts\\dev_usb.ps1",
    "i18n:pack": "powershell -ExecutionPolicy Bypass -File scripts\\make-i18n-translation-pack.ps1",
    "i18n:audit": "node scripts/i18n_audit.js",
    "i18n:rooms:patch": "node scripts/i18n_rooms_patch.js",
    "i18n:ui-risk": "node scripts/i18n_ui_risk.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^6.6.0",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/native-stack": "^6.11.0",
    "expo": "~54.0.33",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.9",
    "expo-font": "~14.0.11",
    "expo-image-picker": "~17.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.7",
    "expo-notifications": "~0.32.16",
    "firebase": "^10.14.1",
    "geofire-common": "^5.2.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-drawer-layout": "^4.2.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "babel-plugin-module-resolver": "^5.0.3",
    "babel-preset-expo": "^54.0.10",
    "typescript": "~5.9.2"
  }
}
