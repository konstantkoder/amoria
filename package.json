{
  "name": "amoria-api",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Amoria backend API foundation.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "start:text-moderation": "node dist/src/moderation/text-moderation.server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-db-migrate.mjs",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs",
    "admin:create-owner": "node scripts/admin-create-owner.mjs",
    "admin:reset-owner-mfa": "node scripts/admin-reset-owner-mfa.mjs",
    "admin:web:dev": "npm --prefix admin-web run dev",
    "admin:web:build": "npm --prefix admin-web run build",
    "moderation:install": "powershell -ExecutionPolicy Bypass -File scripts/install-local-moderation-model.ps1",
    "moderation:worker": "node scripts/run-moderation-worker.mjs",
    "text-moderation:install": "powershell -ExecutionPolicy Bypass -File scripts/install-local-text-moderation-model.ps1",
    "text-moderation:qa": "node scripts/run-text-moderation-qa.mjs",
    "message-moderation:e2e": "node --import tsx scripts/run-message-moderation-e2e.mjs",
    "qa:backup-restore:seed": "node scripts/qa-backup-restore-fixture.mjs seed",
    "qa:backup-restore:verify": "node scripts/qa-backup-restore-fixture.mjs verify",
    "qa:bounded-load": "node scripts/qa-bounded-load.mjs",
    "scale:seed": "node scripts/load/seed-scale-dataset.mjs",
    "scale:fixtures": "node scripts/load/generate-scale-fixtures.mjs",
    "scale:explain": "node scripts/load/explain-hot-queries.mjs",
    "admin:message-moderation:runtime-qa": "node --import tsx scripts/run-admin-message-moderation-runtime-qa.mjs",
    "media:diagnostics": "node --import tsx src/media/media-diagnostics.cli.ts",
    "db:push": "drizzle-kit push",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:migrate": "docker compose exec api npm run db:migrate",
    "docker:dev": "docker compose up -d && docker compose logs -f api"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "nodemailer": "^9.0.5",
    "pg": "^8.20.0",
    "redis": "^5.12.1",
    "sharp": "^0.35.3",
    "zod": "^4.4.2"
  },
  "optionalDependencies": {
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
