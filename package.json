{
  "name": "amoria-api",
  "version": "0.1.0",
  "private": true,
  "description": "Independent Amoria backend API foundation.",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx tests/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/run-db-migrate.mjs",
    "admin:bootstrap": "node scripts/admin-bootstrap.mjs",
    "admin:create-owner": "node scripts/admin-create-owner.mjs",
    "admin:web:dev": "npm --prefix admin-web run dev",
    "admin:web:build": "npm --prefix admin-web run build",
    "db:push": "drizzle-kit push",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f api",
    "docker:migrate": "docker compose exec api npm run db:migrate",
    "docker:dev": "docker compose up -d && docker compose logs -f api"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1041.0",
    "@aws-sdk/s3-request-presigner": "^3.1041.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^10.0.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "jsonwebtoken": "^9.0.3",
    "mime-types": "^3.0.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.20.0",
    "sharp": "^0.34.5",
    "zod": "^4.4.2"
  },
  "optionalDependencies": {
    "argon2": "^0.44.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
