{
  "expo": {
    "name": "Amoria",
    "slug": "amoria",
    "version": "1.0.0",
    "icon": "./assets/icons/amoria_android_launcher_icon_1024.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050816"
    },
    "orientation": "portrait",
    "androidStatusBar": {
      "backgroundColor": "#050816",
      "barStyle": "light-content"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "jsEngine": "hermes",
    "plugins": [
      "expo-dev-client",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E6B976",
          "defaultChannel": "default"
        }
      ],
      "expo-secure-store"
    ],
    "assetBundlePatterns": [
      "src/assets/backgrounds/*"
    ],
    "ios": {
      "usesAppleSignIn": false,
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Мы используем геолокацию для Nearby и Together matching. Точная позиция не показывается другим людям.",
        "NSPhotoLibraryUsageDescription": "Нужен доступ к фотобиблиотеке для выбора фотографий."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/amoria_adaptive_foreground_1024.png",
        "backgroundImage": "./assets/icons/amoria_adaptive_background_1024.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_EXTERNAL_STORAGE",
        "NOTIFICATIONS"
      ],
      "package": "com.anonymous.amoria",
      "usesCleartextTraffic": true,
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "eas": {
        "projectId": "e719ffd9-ab8a-457c-abad-48803775dd4f"
      }
    },
    "owner": "kostiantyn111"
  }
}
