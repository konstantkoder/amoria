{
  "expo": {
    "name": "Amoria",
    "slug": "amoria",
    "scheme": "amoria",
    "version": "1.0.0",
    "backgroundColor": "#050816",
    "icon": "./assets/icons/amoria_android_launcher_icon_1024.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#050816"
    },
    "orientation": "portrait",
    "androidStatusBar": {
      "backgroundColor": "#050816",
      "barStyle": "light-content"
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "jsEngine": "hermes",
    "plugins": [
      "expo-dev-client",
      "expo-iap",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E6B976",
          "defaultChannel": "amoria_updates"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Amoria uses your photo library so you can choose profile, chat, and announcement photos.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": false
          }
        }
      ],
      "expo-secure-store"
    ],
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "bundleIdentifier": "com.kostiantyndemidets.amoria",
      "usesAppleSignIn": false,
      "supportsTablet": false,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Amoria uses your location for Nearby and Together matching. Your exact location is not shown to other users.",
        "NSPhotoLibraryUsageDescription": "Amoria uses your photo library so you can choose profile, chat, and announcement photos."
      }
    },
    "android": {
      "backgroundColor": "#050816",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/amoria_adaptive_foreground_1024.png",
        "backgroundImage": "./assets/icons/amoria_adaptive_background_1024.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.kostiantyndemidets.amoria",
      "softwareKeyboardLayoutMode": "resize"
    },
    "extra": {
      "eas": {
        "projectId": "e719ffd9-ab8a-457c-abad-48803775dd4f"
      }
    },
    "owner": "kostiantyn111"
  }
}
