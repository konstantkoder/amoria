# Supply this file out-of-band as .env.production. Never commit real values.
NODE_ENV=production
PORT=4000
RELEASE_SHA=0000000000000000000000000000000000000000
APP_VERSION=0.1.0
SUPPORT_EMAIL=support@example.com
API_IMAGE=registry.example/amoria-api
ADMIN_WEB_IMAGE=registry.example/amoria-admin-web
PHOTO_WORKER_IMAGE=registry.example/amoria-photo-worker
# Resolve and pin the approved Valkey image by immutable digest before deploy.
VALKEY_IMAGE=valkey/valkey@sha256:replace-with-approved-immutable-digest
VALKEY_MAXMEMORY=512mb
API_HOST_PORT=4000
ADMIN_WEB_HOST_PORT=4174

POSTGRES_MIGRATION_PASSWORD=replace-with-random-migration-password
POSTGRES_RUNTIME_PASSWORD=replace-with-random-runtime-password
DATABASE_MIGRATION_URL=postgres://amoria_migrator:replace-with-random-migration-password@postgres:5432/amoria
DATABASE_RUNTIME_URL=postgres://amoria_runtime:replace-with-random-runtime-password@postgres:5432/amoria
DATABASE_URL=postgres://amoria_runtime:replace-with-random-runtime-password@postgres:5432/amoria
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=5000
DB_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=15000
API_MAX_IN_FLIGHT_REQUESTS=1000

JWT_SECRET=replace-with-random-32-byte-or-longer-secret
AUTH_SECURITY_HMAC_SECRET=replace-with-a-different-random-32-byte-or-longer-secret
MESSAGE_ABUSE_HMAC_SECRET=replace-with-another-random-32-byte-or-longer-secret
TRUST_PROXY=172.28.0.1/32
CORS_ALLOWED_ORIGINS=https://admin.example.com
METRICS_TOKEN=replace-with-random-internal-metrics-secret-at-least-32-chars
REALTIME_BUS_URL=redis://valkey:6379
REALTIME_BUS_CHANNEL=amoria:realtime:v1
REALTIME_EVENT_MAX_BYTES=262144
WS_MAX_CONNECTIONS_PER_INSTANCE=5000
WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_SUBSCRIPTIONS_PER_CONNECTION=50
WS_MAX_BUFFERED_BYTES=262144
WS_ACCESS_REVALIDATION_INTERVAL_MS=30000

PUBLIC_API_URL=https://api.example.com
PUBLIC_MEDIA_URL=https://api.example.com/media
ALLOW_LOCAL_PUBLIC_URLS=false
OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=replace-with-random-storage-access-key
S3_SECRET_KEY=replace-with-random-32-byte-storage-secret
S3_BUCKET=amoria
S3_PUBLIC_BASE_URL=https://objects.example.com/amoria
PUBLIC_MEDIA_DELIVERY_MODE=presigned
PUBLIC_MEDIA_PRESIGN_EXPIRES_SEC=60
S3_FORCE_PATH_STYLE=1

TEXT_MODERATION_ENABLED=true
TEXT_MODERATION_TRANSPORT=http
TEXT_MODERATION_SERVICE_URL=http://text-moderation:4010
TEXT_MODERATION_SERVICE_TOKEN=replace-with-random-internal-text-secret-at-least-32-chars
TEXT_MODERATION_TIMEOUT_MS=5000
TEXT_MODEL_HOST_DIR=/srv/amoria/models/text-moderation-v1/model
PERSON_MODEL_HOST_DIR=/srv/amoria/models/person-presence-v1
GRAPHIC_SAFETY_MODEL_HOST_DIR=/srv/amoria/models/graphic-safety-v1
RETENTION_WORKER_INTERVAL_MS=60000
READ_NOTIFICATION_RETENTION_DAYS=180
PUSH_DELIVERY_RETENTION_DAYS=30
PHOTO_JOB_RETENTION_DAYS=30
EXPO_PUSH_ACCESS_TOKEN=
EXPO_PUSH_SEND_URL=https://exp.host/--/api/v2/push/send
EXPO_PUSH_RECEIPTS_URL=https://exp.host/--/api/v2/push/getReceipts
PUSH_REQUEST_TIMEOUT_MS=5000
PUSH_WORKER_INTERVAL_MS=5000

SMTP_HOST=mail.example.internal
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
# Leave both blank only for an intentional private-network relay that does not require SMTP AUTH.
SMTP_USER=
SMTP_PASSWORD=
SMTP_CONNECTION_TIMEOUT_MS=5000
MAIL_FROM=no-reply@example.com
MAIL_FROM_NAME=Amoria
